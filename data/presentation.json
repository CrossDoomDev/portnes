{
  "schema": 1,
  "messages": {
    "1": {
      "lines": [
        "\"SNAKE!\"",
        "\"Watch out -use radar-",
        "gigantic enemy objects",
        "up ahead!\""
      ]
    },
    "2": {
      "lines": [
        "Contact our spy",
        "\"TOMMY J\".  He is in",
        "prisoners camp.",
        "He will give you info",
        "on long range bullet",
        "ability."
      ]
    },
    "3": {
      "lines": [
        "Snake!",
        "Found the train firing",
        "bullets by radar.",
        "Be Careful!"
      ]
    },
    "4": {
      "lines": [
        "Iron Snake,this is the",
        "back up unit. Find the",
        "target. Destroy it!",
        "Enemy's long range",
        "bullets are awesome.",
        "Allies are destroyed."
      ]
    },
    "5": {
      "lines": [
        "Look out ahead,",
        "there is the long range",
        "firing bullet.",
        "Destroy it immediately.",
        "The safety of the back",
        "up unit is your goal."
      ]
    },
    "6": {
      "lines": [
        "The landing was a",
        "success.",
        "We'll start the next",
        "operation now.",
        "Thank you, Snake. We",
        "avoided total wipeout."
      ]
    },
    "7": {
      "lines": [
        "Additional orders:",
        "New contact, named",
        "Ichiban."
      ]
    },
    "8": {
      "lines": [
        "\"SNAKE!\".",
        "Watch it!",
        "Found enemy's secret",
        "base by radar."
      ]
    },
    "9": {
      "lines": [
        "Operation was",
        "successful. we now",
        "occupy the station.",
        "Moving onto next",
        "operation."
      ]
    },
    "10": {
      "lines": [
        "There is a power",
        "station ahead.",
        "Blow it up and cut off",
        "electrical supply."
      ]
    },
    "11": {
      "lines": [
        "Unit calling..........",
        "we are being attacked",
        "from a bomber.",
        "Iron Snake, get to",
        "enemy's air force base",
        "and turn it to rubble!"
      ]
    },
    "12": {
      "lines": [
        "Snake! Bombers are eve-",
        "rywhere.We are having a",
        "tough time hanging on!",
        "If only one of us lives",
        ",we will do our best to",
        "support you. Good luck."
      ]
    },
    "13": {
      "lines": [
        "The bombs have stopped.",
        "Cannot find your",
        "postion................",
        "radar is blocked!",
        "Snake...... stay alive!",
        "Go for it !"
      ]
    },
    "14": {
      "lines": [
        "Surrender immediately!",
        "No way you can win!",
        "Drop all arms and",
        "weapons! Otherwise....",
        "we wipe you out!"
      ]
    },
    "252": {
      "lines": [
        "Thanks."
      ]
    },
    "253": {
      "lines": [
        "I'm your friend. Stay",
        "on the railroad, go",
        "straight through the",
        "town. The enemy train",
        "is there.",
        "Shoot it. Good luck."
      ]
    },
    "254": {
      "lines": [
        "I will help you get",
        "into the enemy's base",
        "and destroy their",
        "secret weapons."
      ]
    },
    "255": {
      "lines": [
        "Help!",
        "I'm only survivor! All",
        "allies were destroyed.",
        "Iron Snake......get to",
        "enemy headquarters and",
        "blow it to bits!"
      ]
    }
  },
